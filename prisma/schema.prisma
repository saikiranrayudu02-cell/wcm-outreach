generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  STATE_LEADER
  ZONE_LEADER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  ZONE_LEADER_REVIEW
  STATE_LEADER_REVIEW
  ADMIN_REVIEW
  STATE_AND_ADMIN_REVIEW
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum FormStatus {
  PENDING
  SUBMITTED
  FORWARDED_TO_STATE
  FORWARDED_TO_ADMIN
  REJECTED
  COMPLETED
}

enum MeetingAssignmentStatus {
  CREATED_AND_PENDING_ASSIGNMENT
  ASSIGNED_TO_LEADER
  ACCEPTED_BY_LEADER
  SELF_HANDLED_BY_LEADER
  PENDING_COORDINATOR_SELECTION
  FORWARDED_TO_COORDINATOR
  RECEIVED_BY_COORDINATOR
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                    String                @id @default(uuid())
  username              String                @unique
  passwordHash          String                @map("password_hash")
  role                  Role
  state                 String?
  part                  String?
  zone                  String?
  name                  String
  email                 String                @unique
  emailVerified         Boolean               @map("email_verified")
  image                 String?
  district              String?               @map("district")
  phoneNumber           String?               @map("phone_number")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  
  // Hierarchical Leader-Coordinator Parent Relationship
  parentZonalLeaderId   String?               @map("parent_zonal_leader_id")
  parentZonalLeader     User?                 @relation("ZonalLeaderCoordinators", fields: [parentZonalLeaderId], references: [id], onDelete: SetNull)
  subordinateCoordinators User[]              @relation("ZonalLeaderCoordinators")

  // Master Geographic Relations
  stateId               String?               @map("state_id")
  stateRef              State?                @relation(fields: [stateId], references: [id], onDelete: SetNull)
  zoneId                String?               @map("zone_id")
  zoneRef               Zone?                 @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  districtId            String?               @map("district_id")
  districtRef           District?             @relation(fields: [districtId], references: [id], onDelete: SetNull)

  // Audit Logs
  performedOrgAudits    OrganizationAuditLog[] @relation("OrgAuditActor")
  targetedOrgAudits     OrganizationAuditLog[] @relation("OrgAuditTargetUser")

  accounts              Account[]
  sessions              Session[]
  meetingConfirmations  MeetingConfirmation[]
  receivedNotifications Notification[]        @relation("ReceivedNotifications")
  sentNotifications     Notification[]        @relation("SentNotifications")
  
  meetingReports        MeetingReport[]
  reportAuditLogs       ReportAuditLog[]
  reviewerComments      ReviewerComment[]
  callAttempts          CallAttempt[]

  createdMeetings       Meeting[]             @relation("CreatedMeetings")
  assignedMeetings      Meeting[]             @relation("AssignedMeetings")
  originalLeaderMeetings Meeting[]            @relation("OriginalLeaderMeetings")
  prevAssigneeHistories MeetingAssignmentHistory[] @relation("PrevAssigneeHistory")
  newAssigneeHistories  MeetingAssignmentHistory[] @relation("NewAssigneeHistory")
  actionByHistories     MeetingAssignmentHistory[] @relation("ActionByHistory")

  @@index([username])
  @@index([role])
  @@index([state])
  @@index([part])
  @@index([zone])
  @@index([district])
  @@index([phoneNumber])
  @@index([stateId])
  @@index([zoneId])
  @@index([districtId])
  @@index([parentZonalLeaderId])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verifications")
}

model MeetingReport {
  id                 String              @id @default(uuid())
  reportId           String              @unique @map("report_id") // E.g., MTG-1001 or MR-2026-00015
  title              String?             @map("title")
  leaderId           String              @map("leader_id")
  leader             User                @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  status             ReportStatus        @default(DRAFT)
  version            Int                 @default(1)
  submittedAt        DateTime?           @map("submitted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  requestedChangesBy String?             @map("requested_changes_by") // "ZONE", "STATE", "ADMIN"

  verificationSheet  VerificationSheet?
  attendanceRecord   AttendanceRecord?
  afterMeetingReport AfterMeetingReport?

  auditLogs          ReportAuditLog[]
  reviewerComments   ReviewerComment[]
  callAttempts       CallAttempt[]
  meetingAssignment  Meeting?

  @@index([leaderId])
  @@index([status])
  @@map("meeting_reports")
}

model ReviewerComment {
  id              String        @id @default(uuid())
  meetingReportId String        @map("meeting_report_id")
  meetingReport   MeetingReport @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  reviewerId      String        @map("reviewer_id")
  reviewer        User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  formType        String        @default("VERIFICATION") @map("form_type")
  comment         String
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([meetingReportId])
  @@index([reviewerId])
  @@map("reviewer_comments")
}

model VerificationSheet {
  id                     String        @id @default(uuid())
  meetingReportId        String        @unique @map("meeting_report_id")
  meetingReport          MeetingReport @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  status                 FormStatus    @default(PENDING)
  submittedAt            DateTime?     @map("submitted_at")
  approvedAt             DateTime?     @map("approved_at")
  rejectedAt             DateTime?     @map("rejected_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  convenerName           String        @map("convener_name")
  churchMinistryName     String        @map("church_ministry_name")
  stateDistrictCity      String        @map("state_district_city")
  contactNumber          String        @map("contact_number")
  meetingDates           String        @map("meeting_dates")
  numberOfDays           Int           @map("number_of_days")
  expectedAttendance     Int           @map("expected_attendance")
  yearsOfMinistry        Int           @map("years_of_ministry")
  churchMembers          Int           @map("church_members")
  workersLeaders         Int           @map("workers_leaders")
  knowAboutWcm           String        @map("know_about_wcm")
  readWcmBooks           Boolean       @map("read_wcm_books")
  attendedProphetMeeting Boolean       @map("attended_prophet_kiran_meeting")
  meetingHallStage       String        @map("meeting_hall_stage")
  soundSystem            String        @map("sound_system")
  accommodationTeam      String        @map("accommodation_team")
  volunteerSupport       String        @map("volunteer_support")

  callAttempts           CallAttempt[]

  // Call Lock fields (Permanent lock once answered)
  isCallLocked           Boolean       @default(false) @map("is_call_locked")
  callLockedReason       String?       @map("call_locked_reason")
  callAnsweredAt         DateTime?     @map("call_answered_at")

  // Hierarchical Geographic fields
  state                  String?       @map("state")
  zone                   String?       @map("zone")
  district               String?       @map("district")
  part                   String?       @map("part")

  @@index([isCallLocked])
  @@index([state])
  @@index([zone])
  @@index([district])
  @@index([part])
  @@map("verification_sheets")
}

model AttendanceRecord {
  id              String        @id @default(uuid())
  meetingReportId String        @unique @map("meeting_report_id")
  meetingReport   MeetingReport @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  status          FormStatus    @default(PENDING)
  submittedAt     DateTime?     @map("submitted_at")
  approvedAt      DateTime?     @map("approved_at")
  rejectedAt      DateTime?     @map("rejected_at")
  date            DateTime      @db.Date
  location        String
  fieldExecuter   String        @map("field_executer")
  coordinator     String        @default("") @map("coordinator")
  membersAttended Int           @map("members_attended")
  pastorsAttended Int           @map("pastors_attended")
  remarks         String
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([date])
  @@map("attendance_records")
}

model AfterMeetingReport {
  id                       String        @id @default(uuid())
  meetingReportId          String        @unique @map("meeting_report_id")
  meetingReport            MeetingReport @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  status                   FormStatus    @default(PENDING)
  submittedAt              DateTime?     @map("submitted_at")
  approvedAt               DateTime?     @map("approved_at")
  rejectedAt               DateTime?     @map("rejected_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  overallMeetingOutcome    String        @map("overall_meeting_outcome")
  congregationResponse     String        @map("congregation_response")
  continueFellowship       Boolean       @map("continue_fellowship")
  futureOpportunities      String[]      @map("future_opportunities")
  localChurchInfluence     String        @map("local_church_influence")
  networkOfPastors         String        @map("network_of_pastors")
  strengthsObserved        String        @map("strengths_observed")
  challengesObserved       String        @map("challenges_observed")
  opportunityForWcm        String        @map("opportunity_for_wcm")
  coordinatorName          String        @map("coordinator_name")
  designation              String
  signature                String
  submissionDate           DateTime      @map("submission_date") @db.Date
  followingWcmMembersCount Int           @default(0) @map("following_wcm_members_count")

  @@map("after_meeting_reports")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  senderId    String   @map("sender_id")
  title       String   @default("New Message")
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
  @@map("notifications")
}

model MeetingConfirmation {
  id                 String   @id @default(uuid())
  leaderId           String   @map("leader_id")
  meetingDates       String   @map("meeting_dates")
  location           String
  expectedAttendance Int      @map("expected_attendance")
  message            String
  status             String   @default("PENDING")
  adminFeedback      String?  @map("admin_feedback")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  leader             User     @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@index([leaderId])
  @@index([status])
  @@map("meeting_confirmations")
}

model ReportAuditLog {
  id              String        @id @default(uuid())
  meetingReportId String        @map("meeting_report_id")
  meetingReport   MeetingReport @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  actorId         String        @map("actor_id")
  actor           User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  formType        String        @default("VERIFICATION") @map("form_type")
  action          String
  details         String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([meetingReportId])
  @@index([actorId])
  @@index([createdAt])
  @@map("report_audit_logs")
}

model CallAttempt {
  id                  String             @id @default(uuid())
  verificationSheetId String             @map("verification_sheet_id")
  verificationSheet   VerificationSheet  @relation(fields: [verificationSheetId], references: [id], onDelete: Cascade)
  meetingReportId     String             @map("meeting_report_id")
  meetingReport       MeetingReport      @relation(fields: [meetingReportId], references: [id], onDelete: Cascade)
  initiatedById       String?            @map("initiated_by_id")
  initiatedBy         User?              @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  providerRequestId   String?            @map("provider_request_id")
  providerCallId      String?            @map("provider_call_id")
  agentId             Int                @map("agent_id")
  fromNumber          String?            @map("from_number")
  toNumber            String             @map("to_number")
  contactName         String             @map("contact_name")
  churchName          String             @map("church_name")

  status              String             @default("DISPATCHED") // DISPATCHED, IN_PROGRESS, COMPLETED, BUSY, NO_ANSWER, FAILED, CANCELLED
  duration            Int?               @map("duration")
  durationFormatted   String?            @map("duration_formatted")
  recordingUrl        String?            @map("recording_url")
  transcript          String?            @map("transcript") @db.Text
  summary             String?            @map("summary") @db.Text
  sentiment           String?            @map("sentiment")

  attemptNumber       Int                @default(1) @map("attempt_number")
  parentAttemptId     String?            @map("parent_attempt_id")
  parentAttempt       CallAttempt?       @relation("CallRetries", fields: [parentAttemptId], references: [id], onDelete: SetNull)
  retryAttempts       CallAttempt[]      @relation("CallRetries")

  errorCode           String?            @map("error_code")
  errorMessage        String?            @map("error_message")
  metadata            Json?              @map("metadata")

  initiatedAt         DateTime           @default(now()) @map("initiated_at")
  answeredAt          DateTime?          @map("answered_at")
  endedAt             DateTime?          @map("ended_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([verificationSheetId])
  @@index([meetingReportId])
  @@index([providerRequestId])
  @@index([providerCallId])
  @@index([status])
  @@index([createdAt])
  @@map("call_attempts")
}

model Meeting {
  id                    String                   @id @default(uuid())
  referenceId           String                   @unique @map("reference_id")
  meetingDate           DateTime                 @map("meeting_date")
  organizerName         String                   @map("organizer_name")
  state                 String                   @map("state")
  district              String                   @map("district")
  
  createdById           String                   @map("created_by_id")
  createdBy             User                     @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: Restrict)
  
  currentAssigneeId     String?                  @map("current_assignee_id")
  currentAssignee       User?                    @relation("AssignedMeetings", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  currentAssigneeRole   Role?                    @map("current_assignee_role")

  originalLeaderId      String?                  @map("original_leader_id")
  originalLeader        User?                    @relation("OriginalLeaderMeetings", fields: [originalLeaderId], references: [id], onDelete: SetNull)

  status                MeetingAssignmentStatus  @default(ASSIGNED_TO_LEADER) @map("status")
  
  meetingReportId       String?                  @unique @map("meeting_report_id")
  meetingReport         MeetingReport?           @relation(fields: [meetingReportId], references: [id], onDelete: SetNull)

  remarks               String?                  @map("remarks")

  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  assignmentHistory     MeetingAssignmentHistory[]

  @@index([state])
  @@index([district])
  @@index([currentAssigneeId])
  @@index([originalLeaderId])
  @@index([status])
  @@index([meetingDate])
  @@map("meetings")
}

model MeetingAssignmentHistory {
  id                    String                   @id @default(uuid())
  meetingId             String                   @map("meeting_id")
  meeting               Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  previousAssigneeId    String?                  @map("previous_assignee_id")
  previousAssignee      User?                    @relation("PrevAssigneeHistory", fields: [previousAssigneeId], references: [id], onDelete: SetNull)
  previousRole          Role?                    @map("previous_role")

  newAssigneeId         String                   @map("new_assignee_id")
  newAssignee           User                     @relation("NewAssigneeHistory", fields: [newAssigneeId], references: [id], onDelete: Restrict)
  newRole               Role                     @map("new_role")

  assignedById          String                   @map("assigned_by_id")
  assignedBy            User                     @relation("ActionByHistory", fields: [assignedById], references: [id], onDelete: Restrict)

  assignmentAction      String                   @map("assignment_action") // "INITIAL_ADMIN_ASSIGNMENT", "SELF_HANDLED", "FORWARDED_TO_COORDINATOR", "ACCEPTED", "STATUS_CHANGE"
  status                MeetingAssignmentStatus  @map("status")
  remarks               String?                  @map("remarks")

  createdAt             DateTime                 @default(now()) @map("created_at")

  @@index([meetingId])
  @@index([newAssigneeId])
  @@index([assignedById])
  @@index([createdAt])
  @@map("meeting_assignment_histories")
}

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  zones     Zone[]
  users     User[]

  @@map("ministry_states")
}

model Zone {
  id        String     @id @default(uuid())
  name      String
  stateId   String     @map("state_id")
  state     State      @relation(fields: [stateId], references: [id], onDelete: Restrict)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  districts District[]
  users     User[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("ministry_zones")
}

model District {
  id        String     @id @default(uuid())
  name      String
  zoneId    String     @map("zone_id")
  zone      Zone       @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users     User[]

  @@unique([zoneId, name])
  @@index([zoneId])
  @@map("ministry_districts")
}

model OrganizationAuditLog {
  id             String    @id @default(uuid())
  action         String    // "USER_CREATED", "USER_UPDATED", "USER_DEACTIVATED", "USER_REACTIVATED", "PASSWORD_RESET", "STATE_CREATED", "ZONE_CREATED", "DISTRICT_CREATED", "LEADER_ASSIGNED"
  actorId        String    @map("actor_id")
  actor          User      @relation("OrgAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId   String?   @map("target_user_id")
  targetUser     User?     @relation("OrgAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  entityType     String?   @map("entity_type") // "USER", "STATE", "ZONE", "DISTRICT"
  entityId       String?   @map("entity_id")
  previousState  Json?     @map("previous_state")
  newState       Json?     @map("new_state")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("organization_audit_logs")
}

