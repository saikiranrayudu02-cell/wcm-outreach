# ==============================================================================
# WCM Ministry Outreach Platform - Deployment Environment Variables
# ==============================================================================

# 1. DATABASE CONNECTION (Prisma + PostgreSQL / Supabase)
# IMPORTANT FOR VERCEL & SERVERLESS:
# Direct Supabase connections (db.[REF].supabase.co:5432) are IPv6-only and will FAIL on Vercel with:
# "Can't reach database server at db.[REF].supabase.co:5432"
# Always use the Supabase IPv4 Connection Pooler:
# Host: aws-0-[REGION].pooler.supabase.com
# Username: postgres.[PROJECT-REF]
# Port: 5432 (Session mode) or 6543 (Transaction mode with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. BETTER AUTH CONFIGURATION
# Secret key used by Better Auth to encrypt and sign session tokens and cookies.
# Generate in terminal using: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-random-32-byte-string"

# Canonical production URL of your deployment (WITHOUT trailing slash)
# Example on Vercel: https://wcm-outreach.vercel.app
# Example on custom domain: https://outreach.wcm.org
BETTER_AUTH_URL="https://your-production-domain.com"

# 3. PUBLIC APPLICATION URL
# Frontend client base URL (matching your production domain above)
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# 4. SUPABASE CLIENT CREDENTIALS
# Required for Supabase client, SSR cookies, and storage integration.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
